rules_version = '2';

// Firestore security rules for Magnifico.
// - "products": public can read only published products; only the admin can write.
// - "orders":   written exclusively by the server (Firebase Functions / API routes)
//               using the Admin SDK, which bypasses these rules. No client writes.
// - "users":    each signed-in admin can read/write only their own profile doc.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "ADMIN_EMAIL_PLACEHOLDER";
    }

    match /products/{productId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Orders are CREATED only by the server (Stripe webhook, via the Admin
      // SDK, which is not subject to these rules). The admin can read orders
      // and update fields like `status` (e.g. marking one "fulfilled"), but
      // never create or delete one from the client.
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /mail/{mailId} {
      // Consumed by the "Trigger Email" Firebase Extension to send order
      // receipts. Only ever written by the server (Admin SDK); never
      // readable or writable from the client.
      allow read, write: if false;
    }
  }
}
