# ── Supabase (client, safe to expose in the browser) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The ONLY email allowed into /dashboard. Must match the Supabase Auth user
# you create, and the ADMIN_EMAIL_PLACEHOLDER value in supabase/schema.sql.
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# Base currency for prices and Paystack charges. NGN by default; change to
# USD/GHS/ZAR/KES only if you've enabled that settlement currency in your
# Paystack dashboard.
NEXT_PUBLIC_CURRENCY=NGN

# ── Supabase (server-only — Settings > API > service_role key) ─────────────
# Bypasses Row Level Security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack (Settings > API Keys & Webhooks in your Paystack dashboard) ───
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Base URL used for the Paystack checkout callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
